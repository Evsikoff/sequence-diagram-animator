          "reveal": "stagger"
        },
        {
          "id": "rmv4l6o2fp1m",
          "text": "ITinder сразу отвечает «принято» и проверяет подпись.",
          "set": {
            "m18": "visible"
          },
          "highlight": [],
          "camera": {
            "mode": "auto"
